#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKAGE="core-blueprint-likes"
MAIN_FILE="core-blueprint-likes.php"
ENTRY="$ROOT/$MAIN_FILE"
DIST="$ROOT/dist"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

fail() {
  printf 'Likes release build failed: %s\n' "$*" >&2
  exit 1
}

for command in php zip unzip python3 sha256sum find sort touch grep; do
  command -v "$command" >/dev/null 2>&1 || fail "missing required command: $command"
done

[[ -f "$ENTRY" ]] || fail "plugin entrypoint is missing"

VERSION="$(php -r '$s=file_get_contents($argv[1]); if(!preg_match("/Version:\\s+([^\\r\\n]+)/",$s,$m)){exit(2);} echo trim($m[1]);' "$ENTRY")"
CONSTANT_VERSION="$(php -r '$s=file_get_contents($argv[1]); if(!preg_match("/define\\(\\s*[\\x27\\x22]CB_LIKES_VERSION[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]/",$s,$m)){exit(2);} echo trim($m[1]);' "$ENTRY")"

[[ -n "$VERSION" ]] || fail "plugin Version header is unavailable"
[[ "$CONSTANT_VERSION" == "$VERSION" ]] || fail "Version header and CB_LIKES_VERSION differ"
[[ "$VERSION" == "1.0.0-rc1" ]] || fail "unexpected public version: $VERSION (expected 1.0.0-rc1)"

ZIP="$DIST/$PACKAGE-$VERSION.zip"
CHECKSUM="$ZIP.sha256"
PACKAGE_ROOT="$STAGE/$PACKAGE"

"$ROOT/tools/check"

rm -rf "$DIST"
mkdir -p "$DIST" "$PACKAGE_ROOT"

for path in   "$MAIN_FILE"   readme.txt   THIRD-PARTY-LICENSES.md   src   assets   languages; do
  [[ -e "$ROOT/$path" ]] || fail "required release path is missing: $path"
  cp -R "$ROOT/$path" "$PACKAGE_ROOT/"
done

find "$PACKAGE_ROOT" -type f \( -name '.DS_Store' -o -name '*.map' -o -name '*.pyc' \) -delete
find "$PACKAGE_ROOT" -exec touch -t 198001010000 {} +

(
  cd "$STAGE"
  zip -X -q "$ZIP" "$PACKAGE/"
  find "$PACKAGE" -type f -print | LC_ALL=C sort | zip -X -q "$ZIP" -@
)

[[ -s "$ZIP" ]] || fail "release ZIP was not created"
unzip -tqq "$ZIP" || fail "release ZIP integrity check failed"

ZIP_ENTRIES="$(unzip -Z1 "$ZIP")"
[[ -n "$ZIP_ENTRIES" ]] || fail "release ZIP is empty"
FIRST_ENTRY="${ZIP_ENTRIES%%$'\n'*}"
[[ "$FIRST_ENTRY" == "$PACKAGE/" ]] || fail "release ZIP root is not $PACKAGE/"

while IFS= read -r entry; do
  [[ "$entry" == "$PACKAGE/"* ]] || fail "unexpected archive root entry: $entry"
done <<<"$ZIP_ENTRIES"

if grep -Eq '(^|/)(\.git|\.github|tests|tools|docs|dist|build|node_modules|vendor|\.venv)(/|$)' <<<"$ZIP_ENTRIES"; then
  fail "development-only files leaked into the release ZIP"
fi

grep -Fxq "$PACKAGE/$MAIN_FILE" <<<"$ZIP_ENTRIES"   || fail "release package is missing the canonical plugin entrypoint"
grep -Fxq "$PACKAGE/readme.txt" <<<"$ZIP_ENTRIES"   || fail "release package is missing WordPress.org readme.txt"

PACKAGED_ENTRY="$(unzip -p "$ZIP" "$PACKAGE/$MAIN_FILE")"
PACKAGED_VERSION="$(printf '%s' "$PACKAGED_ENTRY" | php -r '$s=stream_get_contents(STDIN); preg_match("/Version:\\s+([^\\r\\n]+)/",$s,$m); echo trim($m[1] ?? "");')"
PACKAGED_CONSTANT="$(printf '%s' "$PACKAGED_ENTRY" | php -r '$s=stream_get_contents(STDIN); preg_match("/define\\(\\s*[\\x27\\x22]CB_LIKES_VERSION[\\x27\\x22]\\s*,\\s*[\\x27\\x22]([^\\x27\\x22]+)[\\x27\\x22]/",$s,$m); echo trim($m[1] ?? "");')"

[[ "$PACKAGED_VERSION" == "$VERSION" ]] || fail "packaged Version header differs from source"
[[ "$PACKAGED_CONSTANT" == "$VERSION" ]] || fail "packaged version constant differs from source"

(
  cd "$DIST"
  sha256sum "$(basename "$ZIP")" > "$(basename "$CHECKSUM")"
)
[[ -s "$CHECKSUM" ]] || fail "release checksum was not created"
SHA256="$(awk '{print $1}' "$CHECKSUM")"

printf 'Core Blueprint Likes release package: PASS\nVersion: %s\nArtifact: %s\nCanonical root: %s/\nChecksum: %s\nSHA-256: %s\n'   "$VERSION" "$ZIP" "$PACKAGE" "$CHECKSUM" "$SHA256"
