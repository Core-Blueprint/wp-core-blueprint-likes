msgid "Choose from the small bundled Lucide icon set. No external icon library is loaded."
msgstr "Wähle aus dem kleinen mitgelieferten Lucide-Icon-Set. Es wird keine externe Icon-Bibliothek geladen."

msgid "Copy"
msgstr "Kopieren"

msgid "Copy shortcode"
msgstr "Shortcode kopieren"

msgid "Shortcode copied."
msgstr "Shortcode kopiert."

msgid "Settings saved."
msgstr "Einstellungen gespeichert."

msgid "Lightweight privacy-first likes and optional dislikes for WordPress posts and users, with optional Bricks integration."
msgstr "Leichtgewichtige, datenschutzfreundliche Likes und optionale Dislikes für WordPress-Beiträge und Benutzer, mit optionaler Bricks-Integration."

msgid "Likes: settings changed"
msgstr "Likes: Einstellungen geändert"
