#: src/Admin/Overview.php:37
msgid ""
"Use General for global behavior, Post types for target-specific overrides, "
"User profiles for member reactions, and Integrations for builder and "
"shortcode usage."
msgstr ""
"Utilisez Général pour le comportement global, Types de publication pour les "
"remplacements spécifiques aux cibles, Profils utilisateurs pour les "
"réactions des membres et Intégrations pour l’utilisation du builder et des "
"shortcodes."

#: src/Integration/Bricks/Elements/Element.php:31
