msgstr "Globale Beschriftung übernehmen"

msgid "Inherit global logged-out message"
msgstr "Globalen Hinweis für abgemeldete Besucher übernehmen"

msgid "Inherit global setting"
msgstr "Globale Einstellung übernehmen"

msgid "Inline SVG"
msgstr "Inline-SVG"

msgid "is"
msgstr "ist"

msgid "Label"
msgstr "Beschriftung"

msgid "Leave empty to inherit the global message."
msgstr "Leer lassen, um den globalen Hinweis zu übernehmen."

msgid "Like"
msgstr "Gefällt mir"

msgid "like button for the current target."
msgstr "Like-Schaltfläche für das aktuelle Ziel."

